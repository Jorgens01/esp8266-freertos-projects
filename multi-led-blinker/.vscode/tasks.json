{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP8266: Build",
            "type": "shell",
            "command": "${workspaceFolder}/../scripts/build.sh",
            "args": [
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "ESP8266: Clean",
            "type": "shell",
            "command": "${workspaceFolder}/../scripts/clean.sh",
            "args": [
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        },
        {
            "label": "ESP8266: Flash",
            "type": "shell",
            "command": "${workspaceFolder}/../scripts/flash.sh",
            "args": [
                "${workspaceFolder}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "ESP8266: Monitor",
            "type": "shell",
            "command": "${workspaceFolder}/../scripts/monitor.sh",
            "args": [
                "${workspaceFolder}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "ESP8266: Flash and Monitor",
            "type": "shell",
            "command": "${workspaceFolder}/../scripts/flash_monitor.sh",
            "args": [
                "${workspaceFolder}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "ESP8266: Menuconfig",
            "type": "shell",
            "command": "${workspaceFolder}/../scripts/menuconfig.sh",
            "args": [
                "${workspaceFolder}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}